{
  "$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "files": {
    "includes": ["src/**"],
    "excludes": ["src/test/fixtures/**"],
    "experimentalScannerIgnores": ["dist/", "docs/", "node_modules/"]
  }
}
